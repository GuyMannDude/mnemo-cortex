__pycache__/
*.pyc
node_modules/
.venv*/
mnemo_cortex.egg-info/
dist/
build/
~/
# Only the harness OUTPUTS — a blanket tests/ongoing/ hid new harness
# files from git add (two tracked files were already inside).
tests/ongoing/feed-log.jsonl
tests/ongoing/test-results.jsonl
tests/ongoing/mnemo-test-results.md

# Passport Lane — never track anyone's private deny/redaction maps.
*.local.yaml
tests/ongoing/*.jsonl
tests/ongoing/*-results.md

# experiment data — names memory topics; keep private
tools/experiments/**/recalls.jsonl
tools/experiments/**/queries.txt

# archive-file.sh copies (brain doctrine: archive before destructive) live beside originals; never commit them
*.bak-*
