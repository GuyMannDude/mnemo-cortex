{
  // ┌───────────────────────────────────────────────────────────────┐
  // │  THIS IS A SETTINGS FILE, NOT INSTALL INSTRUCTIONS.           │
  // │                                                               │
  // │  Looking for how to install Mnemo Cortex?  ->  ./INSTALL.md   │
  // │                                                               │
  // │  You do not need to edit this file to install Mnemo. The      │
  // │  defaults work as they are when OPENROUTER_API_KEY is set     │
  // │  in your environment. No key, no cloud: swap in the           │
  // │  all-local reasoning block shown above "reasoning".           │
  // │  Change something here only if you want a different port,     │
  // │  data directory, or provider.                                 │
  // └───────────────────────────────────────────────────────────────┘
  //
  // Mnemo Cortex — robot.install manifest
  //
  // Non-interactive install recipe for AI agents and CI. Pair with
  // ./robot-install.sh. Single JSON object, // line comments allowed.
  //
  // The agent / operator fills in the values below, then runs:
  //   ./robot-install.sh
  // and parses the JSON object on stdout to confirm success.
  //
  // Sensible defaults are baked in. A block you leave out takes the
  // defaults shown here, and reasoning defaults to OpenRouter, so a
  // manifest with only the "service" block still needs
  // OPENROUTER_API_KEY in the environment.

  // robot-install.sh writes these settings to
  // ~/.config/mnemo-cortex/mnemo-cortex.yaml and the service it installs
  // loads that file, so every block below takes effect. Running it again
  // keeps that file, rewrites the env file and the unit, and restarts the
  // service. An older install (its mnemo-cortex.env has no AGENTB_CONFIG
  // line) kept its memories in ~/.agentb: running this again copies them
  // to data_dir, checks every file, and leaves the originals in place.

  "service": {
    "host": "127.0.0.1",
    "port": 50001,
    "data_dir": "~/.mnemo-cortex"
  },

  // Reasoning provider used for preflight checks and summarization.
  // api_key_env names the environment variable that holds the key. The
  // installer reads it at install time and writes it into the 0600 env
  // file the service loads; the config only says ${NAME}, never the key.
  // If that variable is not set, the installer stops before writing
  // anything and says so.
  //
  // All local, no cloud calls: replace the block below with
  //   "reasoning": {"provider": "ollama", "model": "qwen2.5:32b-instruct",
  //                 "api_base": "http://localhost:11434", "api_key_env": ""},
  // api_key_env must be "" (leaving it out falls back to OPENROUTER_API_KEY).
  // Pull the model in Ollama first; any Ollama model you have pulled works.
  "reasoning": {
    "provider": "openrouter",
    "model": "google/gemini-2.5-flash",
    "api_base": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY"
  },

  // Embedding provider — local Ollama by default. The memory index holds
  // 768-number vectors (nomic-embed-text's size); a model that returns a
  // different size is refused at save time, so keep nomic-embed-text
  // unless you know your model returns 768. A hosted provider takes an
  // api_key_env here the same way reasoning does. Once memories exist,
  // keep the same model: vectors from two models don't compare.
  "embedding": {
    "provider": "ollama",
    "model": "nomic-embed-text",
    "api_base": "http://localhost:11434"
  },

  // v3 decay thresholds. Override per-deployment. Topology decays
  // fast because IPs / ports / process state change often; relationship
  // facts (collaborator notes) decay slow.
  "decay": {
    "topology_warn_days": 30,
    "topology_stale_days": 90,
    "current_state_warn_days": 90,
    "relationship_warn_days": 180,
    "session_log_warn_days": 90
  },

  // systemd user-unit name. Set enabled=false to skip the systemd
  // step (for environments without systemd, e.g. macOS or containers).
  "systemd": {
    "enabled": true,
    "service_name": "mnemo-cortex"
  },

  // Smoke test exercises /health, then a save → recall round-trip.
  "smoke_test": {
    "enabled": true,
    "agent_id": "robot-install-smoke"
  },

  // Optional: seed the Phase 3 Facts table from a YAML of canonical truths so
  // exact lookups don't lose to stale fuzzy recall. Disabled by default. Point
  // "yaml" at your own file (see tools/seed-facts.example.yaml for the schema).
  // The watcher block can install a git post-commit hook and/or a nightly cron
  // that re-seed when the YAML changes — both off by default.
  "facts_seed": {
    "enabled": false,
    "yaml": "./tools/seed-facts.example.yaml",
    "watcher": {
      "post_commit_hook": false,
      "hook_repo": "",
      "nightly_cron": false,
      "cron_hour": 3,
      "cron_minute": 10
    }
  }
}
